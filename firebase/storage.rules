rules_version = '2';

// ==========================================================
//  MOVIKI — REGRAS DO CLOUD STORAGE — 27/08/2026
//  22/09/2026: + criadores/{uid}/ (pecas dos influenciadores)
//  30/09/2026: + material/ (videos do Material de apoio, leitura publica - P46)
//  03/10/2026: ehAdmin() so com sessao aberta pelo Google (igual a v32 do Firestore)
//  03/10/2026: documentos/ aceita so imagem JPG, PNG, WebP, GIF e HEIC (antes image/* aceitava SVG com script)
//  19/10/2026: + capavideo/{uid}/ (video de capa da pagina publica, P85): leitura publica,
//              so o dono sobe (MP4, ate 4 MB, nome = numero.mp4) e apaga; nao sobrescreve
//  Balde: moviki-app.firebasestorage.app
//
//  Até hoje o projeto NÃO gravava no Storage pelo navegador: as imagens
//  do painel sobem em base64 pelo robô (api/upload-imagem.js), com o
//  Admin SDK, que ignora estas regras. Este arquivo existe por causa do
//  anexo de documento da caixa de mensagens — a primeira coisa que o
//  navegador grava direto no Storage.
//
//  Regra de ouro: fora de documentos/{uid}/, o balde é FECHADO.
// ==========================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Anexos da caixa de mensagens. Uma pasta por lojista, e o nome da
    // pasta É o uid dele — ninguém abre a pasta do vizinho.
    match /documentos/{uid}/{arquivo} {

      allow read: if request.auth != null
                  && (request.auth.uid == uid || ehAdmin());

      // O admin sempre pode anexar. O lojista só quando o dono do Moviki
      // ligou o botão "Mensagens do admin" naquela conversa — a MESMA
      // trava da regra do Firestore, para o arquivo não subir e a mensagem
      // ser recusada depois (arquivo órfão ocupando espaço).
      allow create: if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && tipoOk(request.resource.contentType)
                    && ( ehAdmin() || (request.auth.uid == uid && docsLiberados(uid)) );

      // Arquivo enviado não se sobrescreve: cada anexo nasce com o carimbo
      // de hora no nome. Trocar o conteúdo de um documento já entregue
      // seria falsificar o que a outra pessoa recebeu.
      allow update: if false;

      allow delete: if ehAdmin();
    }

    // ---- O QUE JÁ EXISTIA NO BALDE (não mexer) ----
    // logos/{uid}/*.jpg     = logo do pino, gravada por api/upload-imagem.js
    // produtos/{uid}/*.jpg  = fotos de produto, gravadas pelo mesmo endpoint
    // As duas são lidas pelo VISITANTE ANÔNIMO na página pública — por isso
    // read: if true. Sem estas duas linhas, trocar as regras do Storage apagaria
    // da tela todas as logos e todas as fotos de produto do Moviki.
    // Escrita continua false: quem grava ali é o Admin SDK do robô, que não
    // passa por estas regras.
    match /logos/{uid}/{arquivo} {
      allow read: if true;
      allow write: if false;
    }
    match /produtos/{uid}/{arquivo} {
      allow read: if true;
      allow write: if false;
    }

    // Pecas dos criadores (22/09/2026). Uma pasta por criador; so ele sobe,
    // so ele e o dono do Moviki abrem. O robo social e a Meta baixam pela URL
    // com token (getDownloadURL), que vale independente destas regras — por
    // isso a URL so sai do painel do dono e do endpoint /api/criadores.
    // Arquivo nao se sobrescreve: peca aprovada nao pode trocar de conteudo.
    match /criadores/{uid}/{arquivo} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || ehAdmin());
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && criadorAtivo(uid)
                    && request.resource.size < 100 * 1024 * 1024
                    && request.resource.contentType != null
                    && ( request.resource.contentType.matches('image/(jpeg|png)')
                         || request.resource.contentType == 'video/mp4' );
      allow update: if false;
      allow delete: if request.auth != null
                    && (request.auth.uid == uid || ehAdmin());
    }

    // Videos do Material de apoio do parceiro (30/09/2026, P46). Sairam do
    // repositorio moviki-app (420 MB de mp4 no Git). Sao pecas de divulgacao
    // do proprio Moviki: qualquer um le, como logos/ e
    // produtos/, para o painel do parceiro, a pagina e o robo social
    // baixarem sem token. Escrita: so o dono pelo console ou o Cloud Shell
    // (fora destas regras). Nunca video de lojista aqui.
    // Video de capa da pagina publica (19/10/2026, P85 Fase 2b). Publico como
    // as fotos (a pagina toca para qualquer visitante). Pouco peso de proposito:
    // cada visita baixa o video, e o Storage cobra por GB entregue.
    match /capavideo/{uid}/{arquivo} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
                    && arquivo.matches('[0-9]{10,16}[.]mp4')
                    && request.resource.size < 4 * 1024 * 1024 + 1
                    && request.resource.contentType == 'video/mp4';
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }
    match /material/{arquivo=**} {
      allow read: if true;
      allow write: if false;
    }

    // Todo o resto do balde: fechado para o navegador.
    match /{tudo=**} {
      allow read, write: if false;
    }

    function ehAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function criadorAtivo(uid) {
      return firestore.exists(/databases/(default)/documents/parceiros/$(uid))
        && firestore.get(/databases/(default)/documents/parceiros/$(uid)).data.get('status', '') == 'aprovado'
        && firestore.get(/databases/(default)/documents/parceiros/$(uid)).data.get('criador', false) == true;
    }

    function docsLiberados(uid) {
      return firestore.exists(/databases/(default)/documents/conversas/$(uid))
        && firestore.get(/databases/(default)/documents/conversas/$(uid)).data.docsLiberado == true;
    }

    function tipoOk(t) {
      return t != null && (
        t == 'application/pdf'
        || t.matches('image/(jpeg|png|webp|gif|heic|heif)')
        || t == 'text/plain'
        || t == 'text/csv'
        || t == 'application/msword'
        || t == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        || t == 'application/vnd.ms-excel'
        || t == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
      );
    }
  }
}